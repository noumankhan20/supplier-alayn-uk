# Supplier Portal (supplier-alayn-uk) - copy to .env.local and adjust.

# Backend API (alayn-uk-api). Either the domain or the full /api/v1 URL works.
# Development: http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=https://api.alaynai.com/api/v1

# Restaurant app (alayn-uk), linked from the portal for restaurant owners who sign in here by mistake.
# Development: http://localhost:3000
NEXT_PUBLIC_MAIN_APP_URL=https://alaynai.com
